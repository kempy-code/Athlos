OPENAI_API_KEY=replace_with_your_server_side_key
OPENAI_MODEL=gpt-4o-mini
NODE_ENV=production
PORT=3000
DATA_DIR=/var/lib/athlos

# Optional Garmin Connect integration (requires programme approval)
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=http://localhost:3000/api/integrations/garmin/callback

# Transactional account emails
RESEND_API_KEY=
EMAIL_FROM=Athlos <accounts@example.com>

# Invite-only coach accounts
COACH_INVITE_CODE=
